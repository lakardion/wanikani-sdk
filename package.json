{
  "name": "wanikani-sdk",
  "version": "0.0.1",
  "description": "Typed, runtime-validated TypeScript SDK for the WaniKani v2 API.",
  "keywords": [
    "japanese",
    "kanji",
    "sdk",
    "srs",
    "valibot",
    "wanikani"
  ],
  "homepage": "https://github.com/lakardion/wanikani-sdk#readme",
  "bugs": {
    "url": "https://github.com/lakardion/wanikani-sdk/issues"
  },
  "license": "ISC",
  "author": "Damian Lucero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakardion/wanikani-sdk.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts --outfile dist/index.js --format esm --target node && bun build src/index.ts --outfile dist/index.cjs --format cjs --target node",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "oxlint . && tsc",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "test:dev": "bun test --watch",
    "ci": "bun run format:check && bun run lint && bun test && bun run build",
    "release": "bun run ci && changeset publish"
  },
  "dependencies": {
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.2",
    "@types/bun": "^1.3.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "typescript": "^5.2.2"
  }
}
